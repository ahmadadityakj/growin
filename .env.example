# Database
DATABASE_URL="postgresql://growin:growin@localhost:5432/growin"

# Auth.js — generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-random-secret"
AUTH_URL="http://localhost:3000"

# Seed admin user
SEED_ADMIN_EMAIL="admin@growin.local"
SEED_ADMIN_PASSWORD="admin123"

# Encryption key untuk credential integrasi (32 byte hex, 64 char)
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL_EXTRACTION="gpt-4o-mini"
OPENAI_MODEL_GENERATION="gpt-4.1-mini"

# Search provider: brave | tavily | openai
# Default: pakai BRAVE/TAVILY key jika ada, fallback ke openai
SEARCH_PROVIDER=""
BRAVE_SEARCH_API_KEY=""
TAVILY_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Growin <noreply@domain.com>"
# Signing secret webhook Resend (dari dashboard Resend → Webhooks)
RESEND_WEBHOOK_SECRET=""

# WhatsApp (Fonnte)
FONNTE_TOKEN=""

# n8n (opsional, untuk automation lanjutan)
N8N_WEBHOOK_URL=""
N8N_API_KEY=""

# App
APP_LOCALE="id"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Billing — rekening tujuan transfer yang ditampilkan di halaman /billing
BILLING_BANK_INFO="BCA 0000000000 a.n. Kreava"

# Nomor WA support — untuk request integrasi provider & bantuan user
SUPPORT_WA_NUMBER="6281234567890"

# Inbound email — balasan outreach masuk Inbox via Reply-To l-<leadId>@<domain>
# MX domain ini diarahkan ke forwarder (lihat scripts/email-inbound-worker.js)
INBOUND_EMAIL_DOMAIN="reply.growin.app"
INBOUND_EMAIL_SECRET="ganti-dengan-secret-acak"
